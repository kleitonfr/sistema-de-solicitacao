sServicoRequest $request): View\n{\n    $termoDeBusca = $request->termoDeBusca();\n    $filtroSelecionado = $request->filtroSelecionado();\n\n    $categorias = CategoriaServico::query()\n        ->when(\n            $filtroSelecionado === BuscarCategoriasServicoRequest::FILTRO_PRINCIPAIS,\n            fn ($consulta) => $consulta->somenteEmDestaque(),\n        )\n        ->when(\n            $termoDeBusca !== null,\n            fn ($consulta) => $consulta->contendoTermo($termoDeBusca),\n        )\n        ->get()\n        ->sortBy(fn (CategoriaServico $categoria) => $this->chaveDeOrdenacaoAlfabetica($categoria->nome))\n        ->values();\n\n    return view('servicos.156.categoria-servicos', [\n        'categorias' => $categorias,\n        'termoDeBusca' => $termoDeBusca,\n        'filtroSelecionado' => $filtroSelecionado,\n    ]);\n}"}]}]},"color":{"bgColor":"hsla(205, 100%, 87%, 1)","bgName":"blue-l"},"nodeType":"block"},{"uid":"sMJDGXQ98A","position":{"x":170,"y":-2640},"sizes":{"width":480,"height":74},"autoheight":true,"blockContent":{"type":"doc","content":[{"type":"filePathNode","attrs":{"pathToFile":"","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"novo156\\app\\Http\\Requests\\BuscarCategoriasServicoRequest.php"}]}]},"color":{"bgColor":"hsla(268, 100%, 90%, 1)","bgName":"purple-l"},"nodeType":"block"},{"uid":"IYiQn_Wdv4","position":{"x":180,"y":-2390},"sizes":{"width":610,"height":70},"autoheight":false,"blockContent":{"type":"doc","content":[{"type":"filePathNode","attrs":{"pathToFile":"","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":":\\xampp\\htdocs\\novo156_frontend\\novo156\\app\\Models\\CategoriaServico.php"}]},{"type":"paragraph","content":[{"type":"text","text":" "}]}]},"color":{"bgColor":"hsla(261, 26%, 26%, 1)","bgName":"purple"},"nodeType":"block"},{"uid":"nfqr4ED0Di","position":{"x":730,"y":-2520},"sizes":{"width":590,"height":80},"autoheight":false,"blockContent":{"type":"doc","content":[{"type