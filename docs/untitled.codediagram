},"color":{"bgColor":"hsla(0, 31%, 31%, 1)","bgName":"red"},"nodeType":"block"},{"uid":"RFZfugsR3O","position":{"x":170,"y":-3010},"sizes":{"width":489.953125,"height":80},"autoheight":false,"blockContent":{"type":"doc","content":[{"type":"filePathNode","attrs":{"pathToFile":"","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"novo156\\app\\Http\\Requests\\RegistrarSolicitacao156Request.php"}]},{"type":"paragraph","content":[{"type":"text","text":" "}]}]},"color":{"bgColor":"hsla(268, 100%, 90%, 1)","bgName":"purple-l"},"nodeType":"block"},{"uid":"vBwkorldDm","position":{"x":-1100,"y":-570},"sizes":{"width":90,"height":90.796875},"autoheight":true,"blockContent":{"type":"doc","content":[{"type":"heading","attrs":{"level":2},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"   2"}]}]},"color":{"bgColor":"hsla(205, 100%, 87%, 1)","bgName":"blue-l"},"nodeType":"block"},{"uid":"PVbr6AERwr","position":{"x":-1100,"y":-370},"sizes":{"width":590,"height":468.8125},"autoheight":true,"blockContent":{"type":"doc","content":[{"type":"filePathNode","attrs":{"pathToFile":"","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"novo156\\app\\Services\\CadastroService.php"}]},{"type":"codeBlock","attrs":{"language":"php","wrapCode":true},"content":[{"type":"text","text":"<?php\n\nnamespace App\\Services;\n\nclass CadastroService\n{\n    public function cadastrarPessoaFisica(array $dados): void\n    {\n        // TODO(integração): persistir/enviar à API de cadastro assim que o\n        // contrato for definido pela equipe de backend.\n    }\n\n    public function cadastrarPessoaJuridica(array $dados): void\n    {\n        // TODO(integração): persistir/enviar à API de cadastro assim que o\n        // contrato for definido pela equipe de backend.\n    }\n}\n"}]}]},"color":{"bgColor":"hsla(45, 100%, 82%, 1)","bgName":"yellow-l"},"nodeType":"block"},{"uid":"9T8nKxwioW","position":{"x":-120,"y":-640},"sizes":{"width":90,"height":90.796875},"autoheight":true,"blockContent":{"type":"doc","content":[{"type":"heading","attrs":{"level":2},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"   3"}]}]},"color":{"bgColor":"hsla(205, 100%, 87%, 1)","bgName":"blue-l"},"nodeType":"block"},{"uid":"phMa9KDS0z","position":{"x":-380,"y":1330},"sizes":{"width":999.953125,"height":90},"autoheight":false,"blockContent":{"type":"doc","content":[{"type":"filePathNode","attrs":{"pathToFile":"","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"novo156\\app\\Models\\User.php"}]},{"type":"paragraph","content":[{"type":"text","text":" "}]}]},"color":{"bgColor":"hsla(261, 26%, 26%, 1)","bgName":"purple"},"nodeType":"block"},{"uid":"rNGHHN5w2C","position":{"x":-380,"y":1430},"sizes":{"width":999.953125,"height":90},"autoheight":false,"blockContent":{"type":"doc","content":[{"type":"filePathNode","attrs":{"pathToFile":"","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"novo156\\app\\Models\\SolicitacaoEsic.php"}]},{"type":"paragraph","content":[{"type":"text","text":" "}]}]},"color":{"bgColor":"hsla(261, 26%, 26%, 1)","bgName":"purple"},"nodeType":"block"},{"uid":"fBlIC0cd9i","position":{"x":1630,"y":-430},"sizes":{"width":1270,"height":2078.8125},"autoheight":true,"blockContent":{"type":"doc","content":[{"type":"filePathNode","attrs":{"pathToFile":"","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"novo156\\app\\Services\\Servico156Service.php"}]},{"type":"codeBlock","attrs":{"language":"php","wrapCode":true},"content":[{"type":"text","text":"<?php\n\nnamespace App\\Services;\n\nuse App\\Models\\CategoriaServico;\nuse App\\Models\\Servico156;\nuse App\\Models\\Solicitacao156;\nuse App\\Models\\User;\nuse Illuminate\\Http\\UploadedFile;\nuse Illuminate\\Support\\Arr;\nuse Illuminate\\Support\\Collection;\nuse Illuminate\\Support\\Facades\\DB;\nuse Illuminate\\Support\\Str;\n\nclass Servico156Service\n{\n    private const DISCO_DOS_ANEXOS = 'local';\n\n    private const PREFIXO_DO_PROTOCOLO = '156';\n\n    public function __construct(private readonly GeradorDeProtocolo $geradorDeProtocolo)\n    {\n    }\n\n    /**\n     * @return Collection<int, CategoriaServico>\n     */\n    public function listarCategorias(?string $termoDeBusca, bool $somenteEmDestaque): Collection\n    {\n        return CategoriaServico::query()\n            ->when($somenteEmDestaque, fn ($consulta) => $consulta->somenteEmDestaque())\n            ->get()\n            ->when(\n                $termoDeBusca !== null,\n                fn (Collection $categorias) => $categorias->filter(\n                    fn (CategoriaServico $categoria) => $this->contemTermo(\"{$categoria->nome} {$categoria->descricao}\", $termoDeBusca),\n                ),\n            )\n            ->sortBy(fn (CategoriaServico $categoria) => $this->normalizar($categoria->nome))\n            ->values();\n    }\n\n    public function buscarCategoriaPorSlug(string $slug): CategoriaServico\n    {\n        return CategoriaServico::where('slug', $slug)->firstOrFail();\n    }\n\n    /**\n     * @return Collection<int, Servico156>\n     */\n    public function listarServicosDaCategoria(CategoriaServico $categoria): Collection\n    {\n        return $categoria->servicos\n            ->sortBy(fn (Servico156 $servico) => $this->normalizar($servico->nome))\n            ->values();\n    }\n\n    public function buscarServicoPorSlug(string $slug): Servico156\n    {\n        return Servico156::with('categoria')->where('slug', $slug)->firstOrFail();\n    }\n\n    /**\n     * @param  list<UploadedFile>  $anexos\n     */\n    public function registrarSolicitacao(User $usuario, Servico156 $servico, array $dados, array $anexos): Solicitacao156\n    {\n        return DB::transaction(function () use ($usuario, $servico, $dados, $anexos) {\n            $solicitacao = Solicitacao156::create([\n                ...Arr::only($dados, ['descricao', 'telefone_contato', 'cep', 'logradouro', 'numero', 'bairro', 'ponto_referencia']),\n                'user_id' => $usuario->id,\n                'servico156_id' => $servico->id,\n                'categoria_servico_id' => $servico->categoria_servico_id,\n                'protocolo' => $this->geradorDeProtocolo->gerar(self::PREFIXO_DO_PROTOCOLO, Solicitacao156::class),\n            ]);\n\n            foreach ($anexos as $anexo) {\n                $solicitacao->anexos()->create([\n                    'nome_original' => $anexo->getClientOriginalName(),\n                    'caminho' => $anexo->store(\"solicitacoes-156/{$solicitacao->protocolo}\", self::DISCO_DOS_ANEXOS),\n                ]);\n            }\n\n            return $solicitacao;\n        });\n    }\n\n    public function buscarSolicitacaoDoUsuario(User $usuario, string $protocolo): Solicitacao156\n    {\n        return $usuario->solicitacoes156()\n            ->with(['servico', 'categoria', 'anexos'])\n            ->where('protocolo', $protocolo)\n            ->firstOrFail();\n    }\n\n    private function contemTermo(string $texto, string $termo): bool\n    {\n        return str_contains($this->normalizar($texto), $this->normalizar($termo));\n    }\n\n    /**\n     * Busca e ordenação ignoram acento e caixa no PHP porque o SQLite compara\n     * bytes e o MySQL aplica a collation: no banco, o resultado mudaria\n     * conforme o ambiente.\n     */\n    private function normalizar(string $texto): string\n    {\n        return mb_strtolower(Str::ascii($texto));\n    }\n}\n"}]}]},"color":{"bgColor":"hsla(45, 100%, 82%, 1)","bgName":"yellow-l"},"nodeType":"block"},{"uid":"kGgoqCfEwM","position":{"x":1630,"y":1670},"sizes":{"width":1270,"height":108.296875},"autoheight":true,"blockContent":{"type":"doc","content":[{"type":"filePathNode","attrs":{"pathToFile":"","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"novo156\\app\\Models\\CategoriaServico.php"}]},{"type":"paragraph","content":[{"type":"text","text":" "}]}]},"color":{"bgColor":"hsla(261, 26%, 26%, 1)","bgName":"purple"},"nodeType":"block"},{"uid":"R8mA0dM6-u","position":{"x":1630,"y":1790},"sizes":{"width":1270,"height":108.296875},"autoheight":true,"blockContent":{"type":"doc","content":[{"type":"filePathNode","attrs":{"pathToFile":"","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"novo156\\app\\Models\\Servico156.php"}]},{"type":"paragraph","content":[{"type":"text","text":" "}]}]},"color":{"bgColor":"hsla(261, 26%, 26%, 1)","bgName":"purple"},"nodeType":"block"},{"uid":"dNsOMvOdW2","position":{"x":1630,"y":1910},"sizes":{"width":1270,"height":108.296875},"autoheight":true,"blockContent":{"type":"doc","content":[{"type":"filePathNode","attrs":{"pathToFile":"","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"novo156\\app\\Models\\Solicitacao156.php"}]},{"type":"paragraph","content":[{"type":"text","text":" "}]}]},"color":{"bgColor":"hsla(261, 26%, 26%, 1)","bgName":"purple"},"nodeType":"block"},{"uid":"QWWD_FMIcD","position":{"x":1860,"y":-650},"sizes":{"width":80,"height":90.796875},"autoheight":true,"blockContent":{"type":"doc","content":[{"type":"heading","attrs":{"level":2},"content":[{"type":"text","text":"  "},{"type":"text","marks":[{"type":"bold"}],"text":"4"}]}]},"color":{"bgColor":"hsla(205, 100%, 87%, 1)","bgName":"blue-l"},"nodeType":"block"},{"uid":"2J0gJvee38","position":{"x":2336.494023602637,"y":-417.08707314369803},"sizes":{"width":399.953125,"height":766.3125},"autoheight":true,"blockContent":{"content":[{"type":"filePathNode","attrs":{"pathToFile":"","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"novo156\\app\\Services\\GeradorDeProtocolo.php"}]},{"type":"codeBlock","attrs":{"language":"php","wrapCode":true},"content":[{"type":"text","text":"<?php\n\nnamespace App\\Services;\n\nuse Illuminate\\Database\\Eloquent\\Model;\n\nclass GeradorDeProtocolo\n{\n    /**\n     * Lógica provisória, à espera da definição oficial de protocolo: o\n     * sequencial é a contagem do ano + 1, então repete número se algum\n     * registro for excluído.\n     *\n     * @param  class-string<Model>  $modeloDaSolicitacao\n     */\n    public function gerar(string $prefixo, string $modeloDaSolicitacao): string\n    {\n        $ano = now()->year;\n\n        $quantidadeNoAno = $modeloDaSolicitacao::query()\n            ->whereYear('created_at', $ano)\n            ->lockForUpdate()\n            ->count();\n\n        $sequencial = str_pad((string) ($quantidadeNoAno + 1), 6, '0', STR_PAD_LEFT);\n\n        return \"{$prefixo}-{$ano}-{$sequencial}\";\n    }\n}\n"}]}]},"nodeType":"block"},{"uid":"X18SIaHmY2","position":{"x":2336.494023602637,"y":-417.08707314369803},"sizes":{"width":399.953125,"height":766.3125},"autoheight":true,"blockContent":{"content":[{"type":"filePathNode","attrs":{"pathToFile":"","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"novo156\\app\\Services\\GeradorDeProtocolo.php"}]},{"type":"codeBlock","attrs":{"language":"php","wrapCode":true},"content":[{"type":"text","text":"<?php\n\nnamespace App\\Services;\n\nuse Illuminate\\Database\\Eloquent\\Model;\n\nclass GeradorDeProtocolo\n{\n    /**\n     * Lógica provisória, à espera da definição oficial de protocolo: o\n     * sequencial é a contagem do ano + 1, então repete número se algum\n     * registro for excluído.\n     *\n     * @param  class-string<Model>  $modeloDaSolicitacao\n     */\n    public function gerar(string $prefixo, string $modeloDaSolicitacao): string\n    {\n        $ano = now()->year;\n\n        $quantidadeNoAno = $modeloDaSolicitacao::query()\n            ->whereYear('created_at', $ano)\n            ->lockForUpdate()\n            ->count();\n\n        $sequencial = str_pad((string) ($quantidadeNoAno + 1), 6, '0', STR_PAD_LEFT);\n\n        return \"{$prefixo}-{$ano}-{$sequencial}\";\n    }\n}\n"}]}]},"nodeType":"block"},{"uid":"n2OG6gYogr","position":{"x":780,"y":340},"sizes":{"width":710,"height":661.3125},"autoheight":true,"blockContent":{"type":"doc","content":[{"type":"filePathNode","attrs":{"pathToFile":"","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"novo156\\app\\Services\\GeradorDeProtocolo.php"}]},{"type":"codeBlock","attrs":{"language":"php","wrapCode":true},"content":[{"type":"text","text":"<?php\n\nnamespace App\\Services;\n\nuse Illuminate\\Database\\Eloquent\\Model;\n\nclass GeradorDeProtocolo\n{\n    /**\n     * Lógica provisória, à espera da definição oficial de protocolo: o\n     * sequencial é a contagem do ano + 1, então repete número se algum\n     * registro for excluído.\n     *\n     * @param  class-string<Model>  $modeloDaSolicitacao\n     */\n    public function gerar(string $prefixo, string $modeloDaSolicitacao): string\n    {\n        $ano = now()->year;\n\n        $quantidadeNoAno = $modeloDaSolicitacao::query()\n            ->whereYear('created_at', $ano)\n            ->lockForUpdate()\n            ->count();\n\n        $sequencial = str_pad((string) ($quantidadeNoAno + 1), 6, '0', STR_PAD_LEFT);\n\n        return \"{$prefixo}-{$ano}-{$sequencial}\";\n    }\n}\n"}]}]},"color":{"bgColor":"hsla(45, 100%, 82%, 1)","bgName":"yellow-l"},"nodeType":"block"},{"uid":"G1l6svgWgh","position":{"x":-390,"y":-380},"sizes":{"width":999.953125,"height":1693.8125},"autoheight":true,"blockContent":{"type":"doc","content":[{"type":"filePathNode","attrs":{"pathToFile":"","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"novo156\\app\\Services\\EsicService.php"}]},{"type":"codeBlock","attrs":{"language":"php","wrapCode":true},"content":[{"type":"text","text":"<?php\n\nnamespace App\\Services;\n\nuse App\\Exceptions\\SolicitacaoNaoPodeSerRegistrada;\nuse App\\Logging\\ContextoDaFalha;\nuse App\\Logging\\RegistroDeSeguranca;\nuse App\\Models\\SolicitacaoEsic;\nuse App\\Models\\User;\nuse Illuminate\\Database\\Eloquent\\ModelNotFoundException;\nuse Illuminate\\Http\\UploadedFile;\nuse Illuminate\\Support\\Facades\\DB;\nuse Illuminate\\Support\\Facades\\Log;\nuse Throwable;\n\nclass EsicService\n{\n    private const PREFIXO_DO_PROTOCOLO = 'ESIC';\n\n    private const DIRETORIO_DOS_ANEXOS = 'solicitacoes-esic';\n\n    public function __construct(\n        private readonly GeradorDeProtocolo $geradorDeProtocolo,\n        private readonly ArmazenadorDeAnexos $armazenadorDeAnexos,\n        private readonly RegistroDeSeguranca $registroDeSeguranca,\n    ) {\n    }\n\n    /**\n     * @throws SolicitacaoNaoPodeSerRegistrada\n     */\n    public function registrarSolicitacao(User $usuario, array $dados, ?UploadedFile $anexo): SolicitacaoEsic\n    {\n        $caminhoDoAnexo = null;\n\n        DB::beginTransaction();\n\n        try {\n            if ($anexo !== null) {\n                $caminhoDoAnexo = $this->armazenadorDeAnexos->armazenar($anexo, self::DIRETORIO_DOS_ANEXOS);\n            }\n\n            $solicitacao = SolicitacaoEsic::create([\n                'user_id' => $usuario->id,\n                'protocolo' => $this->geradorDeProtocolo->gerar(self::PREFIXO_DO_PROTOCOLO, SolicitacaoEsic::class),\n                'assunto' => $dados['assunto'],\n                'descricao' => $dados['descricao'],\n                'anexo_nome_original' => $anexo?->getClientOriginalName(),\n                'anexo_caminho' => $caminhoDoAnexo,\n            ]);\n\n            DB::commit();\n        } catch (Throwable $erro) {\n            DB::rollBack();\n            $this->armazenadorDeAnexos->apagar($caminhoDoAnexo === null ? [] : [$caminhoDoAnexo]);\n\n            Log::error('solicitacao_esic_nao_registrada', [\n                ...ContextoDaFalha::deExcecao($erro),\n                'usuario_id' => $usuario->id,\n                'possui_anexo' => $anexo !== null,\n            ]);\n\n            throw SolicitacaoNaoPodeSerRegistrada::por($erro);\n        }\n\n        Log::info('solicitacao_esic_registrada', [\n            'usuario_id' => $usuario->id,\n            'protocolo' => $solicitacao->protocolo,\n            'possui_anexo' => $anexo !== null,\n        ]);\n\n        return $solicitacao;\n    }\n\n    public function buscarSolicitacaoDoUsuario(User $usuario, string $protocolo): SolicitacaoEsic\n    {\n        try {\n            return $usuario->solicitacoesEsic()->where('protocolo', $protocolo)->firstOrFail();\n        } catch (ModelNotFoundException $erro) {\n            $this->registroDeSeguranca->aviso('solicitacao_esic_nao_encontrada_para_o_usuario', [\n                'usuario_id' => $usuario->id,\n                'protocolo' => $protocolo,\n            ]);\n\n            throw $erro;\n        }\n    }\n}\n"}]}]},"color":{"bgColor":"hsla(45, 100%, 82%, 1)","bgName":"yellow-l"},"nodeType":"block"},{"uid":"NxbcLgzO8u","position":{"x":-3290,"y":360},"sizes":{"width":1510,"height":45.3125},"autoheight":true,"blockContent":{"text":"Métodos como buscarSolicitacaoDoUsuario() e registrarSolicitacao() recebem try/catch para tratamento de erro especial pois precisamos realizar mudanças após receber os erros, os demais métodos persistem como estão uma vez que o Laravel naturalmente captura e registra erros. Em seguranca.log erros de acesso indevido e em laravel.log erros de sistema."},"nodeType":"text"},{"uid":"QY8Jtsv5x0","position":{"x":-3460,"y":230},"sizes":{"width":1889.953125,"height":94.296875},"autoheight":true,"blockContent":{"type":"doc","content":[{"type":"heading","attrs":{"level":1},"content":[{"type":"text","marks":[{"type":"italic"}],"text":"PROCESSO DE REGISTRO DE LOGS E LANÇAMENTOS DE ERROS "}]}]},"color":{"bgColor":"hsla(211, 33%, 22%, 1)","bgName":"blue"},"nodeType":"block"},{"uid":"mxrPsGSkev","position":{"x":-2830,"y":480},"sizes":{"width":569.921875,"height":77.96875},"autoheight":false,"blockContent":{"type":"doc","content":[{"type":"filePathNode","attrs":{"pathToFile":"","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"novo156\\app\\Http\\Middleware\\AdicionarContextoDaRequisicao.php"}]},{"type":"codeBlock","attrs":{"language":"php","wrapCode":true},"content":[{"type":"text","text":"<?php\n\nnamespace App\\Http\\Middleware;\n\nuse Closure;\nuse Illuminate\\Http\\Request;\nuse Illuminate\\Support\\Facades\\Context;\nuse Symfony\\Component\\HttpFoundation\\Response;\n\nclass AdicionarContextoDaRequisicao\n{\n    public function handle(Request $request, Closure $next): Response\n    {\n        $identificadorDeCorrelacao = bin2hex(random_bytes(6));\n\n        Context::add('identificador_correlacao', $identificadorDeCorrelacao);\n        Context::addHidden('ip_do_cliente', $request->ip());\n\n        $resposta = $next($request);\n        $resposta->headers->set('X-Identificador-Correlacao', $identificadorDeCorrelacao);\n\n        return $resposta;\n    }\n}\n"}]}]},"color":{"bgColor":"hsla(0, 0%, 90%, 1)","bgName":"gray-l"},"nodeType":"block"},{"uid":"qJRWjXZdTg","position":{"x":-3220,"y":490},"sizes":{"width":360,"height":66.296875},"autoheight":true,"blockContent":{"text":"Middleware global responsável por \"esconder\" ip de usuários e adicionar identificador único ao contexto do erro"},"nodeType":"text"},{"uid":"_1Xc4xrcIe","position":{"x":-2620,"y":650},"sizes":{"width":150,"height":90.796875},"autoheight":true,"blockContent":{"type":"doc","content":[{"type":"heading","attrs":{"level":2},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Controller"}]}]},"color":{"bgColor":"hsla(205, 100%, 87%, 1)","bgName":"blue-l"},"nodeType":"block"},{"uid":"d4PkHtG_7P","position":{"x":-2620,"y":800},"sizes":{"width":150,"height":90.796875},"autoheight":true,"blockContent":{"type":"doc","content":[{"type":"heading","attrs":{"level":2},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Service"}]}]},"color":{"bgColor":"hsla(45, 100%, 82%, 1)","bgName":"yellow-l"},"nodeType":"block"},{"uid":"pofJTR7Nqi","position":{"x":-3170,"y":1060},"sizes":{"width":380,"height":77.96875},"autoheight":false,"blockContent":{"type":"doc","content":[{"type":"filePathNode","attrs":{"pathToFile":"","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"novo156\\app\\Logging\\ContextoDaFalha.php"}]},{"type":"codeBlock","attrs":{"language":"php","wrapCode":true},"content":[{"type":"text","text":"<?php\n\nnamespace App\\Logging;\n\nuse Illuminate\\Database\\QueryException;\nuse Throwable;\n\nfinal class ContextoDaFalha\n{\n    /**\n     * @return array<string, mixed>\n     */\n    public static function deExcecao(Throwable $erro): array\n    {\n        return [\n            'tipo_da_excecao' => $erro::class,\n            'codigo_da_excecao' => $erro->getCode(),\n            'mensagem_da_excecao' => self::mensagemSemDadosPessoais($erro),\n            'arquivo' => basename($erro->getFile()),\n            'linha' => $erro->getLine(),\n            'stack_trace' => $erro->getTraceAsString(),\n        ];\n    }\n\n    /**\n     * A QueryException anexa à mensagem o SQL com os valores já substituídos\n     * (descrição, telefone, endereço do cidadão). A mensagem do driver, que\n     * está na exceção anterior, descreve a falha sem esses valores.\n     * \n     * Eu recebi um Throwable. Se esse Throwable for especificamente uma\n     * QueryException, não confio na getMessage() dela para logar, porque\n     * ela pode carregar a query com os valores.\"\n     */\n    private static function mensagemSemDadosPessoais(Throwable $erro): string\n    {\n        if ($erro instanceof QueryException) {\n            return $erro->getPrevious()?->getMessage() ?? 'Falha em consulta ao banco de dados.';\n        }\n\n        return $erro->getMessage();\n    }\n}\n"}]}]},"color":{"bgColor":"hsla(0, 0%, 90%, 1)","bgName":"gray-l"},"nodeType":"block"},{"uid":"4IQfeRpXXJ","position":{"x":-3230,"y":960},"sizes":{"width":320,"height":87.28125},"autoheight":true,"blockContent":{"text":"Essa classe cria um \"corpo\" fixo de informações a ser registradas em log e realiza tratamento de mensagem quando o erro for uma instância de QueryException."},"nodeType":"text"},{"uid":"ybh0TRdW9d","position":{"x":-2720,"y":1060},"sizes":{"width":150,"height":80},"autoheight":false,"blockContent":{"type":"doc","content":[{"type":"heading","attrs":{"level":2},"content":[{"type":"text","text":"laravel.log"}]}]},"color":{"bgColor":"hsla(142, 31%, 22%, 1)","bgName":"green"},"nodeType":"block"},{"uid":"gOwyjHzbak","position":{"x":-2510,"y":1060},"sizes":{"width":479.953125,"height":77.96875},"autoheight":false,"blockContent":{"type":"doc","content":[{"type":"filePathNode","attrs":{"pathToFile":"","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"novo156\\app\\Exceptions\\SolicitacaoNaoPodeSerRegistrada.php"}]},{"type":"codeBlock","attrs":{"language":"php","wrapCode":true},"content":[{"type":"text","text":"<?php\n\nnamespace App\\Exceptions;\n\nuse RuntimeException;\nuse Throwable;\n\nclass SolicitacaoNaoPodeSerRegistrada extends RuntimeException\n{\n    public const MENSAGEM_PARA_O_CIDADAO = 'Não foi possível concluir sua solicitação. Tente novamente em alguns instantes.';\n\n    public static function por(Throwable $causa): self\n    {\n        return new self(self::MENSAGEM_PARA_O_CIDADAO, 0, $causa);\n    }\n\n    /**\n     * O service já registrou a falha com contexto sem dados pessoais. Sem\n     * este método, o Laravel reportaria a exceção de novo e gravaria a\n     * causa original, cuja mensagem pode conter valores do formulário.\n     */\n    public function report(): bool\n    {\n        return true;\n    }\n}\n"}]}]},"color":{"bgColor":"hsla(0, 0%, 90%, 1)","bgName":"gray-l"},"nodeType":"block"},{"uid":"8Tzi4jnXEL","position":{"x":-2100,"y":990},"sizes":{"width":340,"height":87.28125},"autoheight":true,"blockContent":{"text":"Uma mensagem única é entregue ao cidadão. Através dessa classe eu \"driblo\" o comportamento comum do Laravel que tende a reportar a exceção gravando stacks enormes previous case"},"nodeType":"text"},{"uid":"Xmx09iq7e9","position":{"x":-2410,"y":1190},"sizes":{"width":479.96875,"height":77.96875},"autoheight":false,"blockContent":{"type":"doc","content":[{"type":"filePathNode","attrs":{"pathToFile":"","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"novo156\\app\\Exceptions\\FalhaAoArmazenarAnexo.php"}]},{"type":"codeBlock","attrs":{"language":"php","wrapCode":true},"content":[{"type":"text","text":"<?php\n\nnamespace App\\Exceptions;\n\nuse RuntimeException;\n\nclass FalhaAoArmazenarAnexo extends RuntimeException\n{\n    public static function noDiretorio(string $diretorio): self\n    {\n        return new self(\"Não foi possível gravar o anexo no diretório '{$diretorio}'.\");\n    }\n}\n"}]}]},"color":{"bgColor":"hsla(0, 0%, 90%, 1)","bgName":"gray-l"},"nodeType":"block"},{"uid":"eK0OcbkBC5","position":{"x":-3280,"y":1210},"sizes":{"width":389.96875,"height":77.96875},"autoheight":false,"blockContent":{"type":"doc","content":[{"type":"filePathNode","attrs":{"pathToFile":"","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"novo156\\app\\Logging\\RegistroDeSeguranca.php"}]},{"type":"codeBlock","attrs":{"language":"php","wrapCode":true},"content":[{"type":"text","text":"<?php\n\nnamespace App\\Logging;\n\nuse Illuminate\\Support\\Facades\\Context;\nuse Illuminate\\Support\\Facades\\Log;\n\n/**\n * Único ponto onde o IP do cidadão é gravado. Os services não conhecem HTTP:\n * o IP vem do contexto oculto preenchido pelo middleware da requisição e\n * nunca entra nos logs gerais.\n */\nclass RegistroDeSeguranca\n{\n    private const CANAL = 'seguranca';\n\n    /**\n     * @param  array<string, mixed>  $contexto\n     */\n    public function aviso(string $evento, array $contexto = []): void\n    {\n        Log::channel(self::CANAL)->warning($evento, [\n            ...$contexto,\n            'ip' => Context::getHidden('ip_do_cliente'),\n        ]);\n    }\n}\n"}]}]},"color":{"bgColor":"hsla(0, 0%, 90%, 1)","bgName":"gray-l"},"nodeType":"block"},{"uid":"x0wzBhhsxq","position":{"x":-3180,"y":1330},"sizes":{"width":190,"height":90.796875},"autoheight":true,"blockContent":{"type":"doc","content":[{"type":"heading","attrs":{"level":2},"content":[{"type":"text","text":"seguranca.log"}]}]},"color":{"bgColor":"hsla(142, 31%, 22%, 1)","bgName":"green"},"nodeType":"block"},{"uid":"j8SWKHUeVL","position":{"x":-3700,"y":1330},"sizes":{"width":499.96875,"height":87.28125},"autoheight":true,"blockContent":{"text":" * Único ponto onde o IP do cidadão é gravado. Os services não conhecem HTTP:\n * o IP vem do contexto oculto preenchido pelo middleware da requisição e\n * nunca entra nos logs gerais."},"nodeType":"text"},{"uid":"xvtXfiIukA","position":{"x":-1140,"y":-770},"sizes":{"width":4120,"height":94.296875},"autoheight":true,"blockContent":{"type":"doc","content":[{"type":"heading","attrs":{"level":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"REGRA DE NEGÓCIO"}]}]},"color":{"bgColor":"hsla(45, 100%, 82%, 1)","bgName":"yellow-l"},"nodeType":"block"},{"uid":"1gxQb8FMMc","position":{"x":-2070,"y":480},"sizes":{"width":520,"height":83.8125},"autoheight":true,"blockContent":{"type":"doc","content":[{"type":"paragraph","content":[{"type":"text","text":"HEADER DA RESPOSTA APRESENTA CAMPO \"X-identificador_correlacao\""}]}]},"color":{"bgColor":"hsla(0, 31%, 31%, 1)","bgName":"red"},"nodeType":"block"}],"configs":{"centerX":1001.5269018725121,"centerY":128.04812785506323,"zoomLevel":0.377777766739881},"arrowData":{"arrowsMap":{"arrow-point-bI0wBh3Ufk-bottom-point-PSPLIYKa9J-top":{"to":"point-PSPLIYKa9J-top","from":"point-bI0wBh3Ufk-bottom","label":"Normal Box","direction":"ft","selectable":true},"arrow-point-bI0wBh3Ufk-bottom-point-ytXK_ayIc1-top":{"to":"point-ytXK_ayIc1-top","from":"point-bI0wBh3Ufk-bottom","label":"Code Box","direction":"ft","selectable":true},"arrow-point-hyyRZE3E8u-right-point-6ZopTaEaDZ-left":{"to":"point-6ZopTaEaDZ-left","from":"point-hyyRZE3E8u-right","label":"call","direction":"ft","selectable":true}},"pointsMap":{"point-PSPLIYKa9J-top":{"x":805.9999797489683,"y":60