c","content":[{"type":"filePathNode","attrs":{"pathToFile":"","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"novo156\\app\\Services\\EsicService.php"}]},{"type":"codeBlock","attrs":{"language":"php","wrapCode":true},"content":[{"type":"text","text":"<?php\n\nnamespace App\\Services;\n\nuse App\\Models\\SolicitacaoEsic;\nuse App\\Models\\User;\nuse Illuminate\\Http\\UploadedFile;\nuse Illuminate\\Support\\Facades\\DB;\n\nclass EsicService\n{\n    private const DISCO_DOS_ANEXOS = 'local';\n\n    private const PREFIXO_DO_PROTOCOLO = 'ESIC';\n\n    public function __construct(private readonly GeradorDeProtocolo $geradorDeProtocolo)\n    {\n    }\n\n    public function registrarSolicitacao(User $usuario, array $dados, ?UploadedFile $anexo): SolicitacaoEsic\n    {\n        return DB::transaction(function () use ($usuario, $dados, $anexo) {\n            return SolicitacaoEsic::create([\n                'user_id' => $usuario->id,\n                'protocolo' => $this->geradorDeProtocolo->gerar(self::PREFIXO_DO_PROTOCOLO, SolicitacaoEsic::class),\n                'assunto' => $dados['assunto'],\n                'descricao' => $dados['descricao'],\n                'anexo_nome_original' => $anexo?->getClientOriginalName(),\n                'anexo_caminho' => $anexo?->store('solicitacoes-esic', self::DISCO_DOS_ANEXOS),\n            ]);\n        });\n    }\n\n    public function buscarSolicitacaoDoUsuario(User $usuario, string $protocolo): SolicitacaoEsic\n    {\n        return $usuario->solicitacoesEsic()->where('protocolo', $protocolo)->firstOrFail();\n    }\n}\n"}]}]},"color":{"bgColor":"hsla(45, 100%, 82%, 1)","bgName":"yellow-l"},"nodeType":"block"},{"uid":"9T8nKxwioW","position":{"x":-120,"y":-640},"sizes":{"width":90,"height":91.5},"autoheight":true,"blockContent":{"type":"doc","content":[{"type":"heading","attrs":{"level":2},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"   3"}]}]},"color":{"bgColor":"hsla(205, 100%, 87%, 1)","bgName":"blue-l"},"nodeType":"block"},{"uid":"phMa9KDS0z","position":{"x":-310,"y":420},"sizes":{"width":890,"height":90},"autoheight":false,"blockContent":{"type":"doc","content":[{"type":"filePathNode","attrs":{"pathToFile":"","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"novo156\\app\\Models\\User.php"}]},{"type":"paragraph","content":[{"type":"text","text":" "}]}]},"color":{"bgColor":"hsla(261, 26%, 26%, 1)","bgName":"purple"},"nodeType":"block"},{"uid":"rNGHHN5w2C","position":{"x":-310,"y":520},"sizes":{"width":890,"height":90},"autoheight":false,"blockContent":{"type":"doc","content":[{"type":"filePathNode","attrs":{"pathToFile":"","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"novo156\\app\\Models\\SolicitacaoEsic.php"}]},{"type":"paragraph","content":[{"type":"text","text":" "}]}]},"color":{"bgColor":"hsla(261, 26%, 26%, 1)","bgName":"purple"},"nodeType":"block"},{"uid":"fBlIC0cd9i","position":{"x":1630,"y":-430},"sizes":{"width":1270,"height":2079.5},"autoheight":true,"blockContent":{"type":"doc","content":[{"type":"filePathNode","attrs":{"pathToFile":"","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"novo156\\app\\Services\\Servico156Service.php"}]},{"type":"codeBlock","attrs":{"language":"php","wrapCode":true},"content":[{"type":"text","text":"<?php\n\nnamespace App\\Services;\n\nuse App\\Models\\CategoriaServico;\nuse App\\Models\\Servico156;\nuse App\\Models\\Solicitacao156;\nuse App\\Models\\User;\nuse Illuminate\\Http\\UploadedFile;\nuse Illuminate\\Support\\Arr;\nuse Illuminate\\Support\\Collection;\nuse Illuminate\\Support\\Facades\\DB;\nuse Illuminate\\Support\\Str;\n\nclass Servico156Service\n{\n    private const DISCO_DOS_ANEXOS = 'local';\n\n    private const PREFIXO_DO_PROTOCOLO = '156';\n\n    public function __construct(private readonly GeradorDeProtocolo $geradorDeProtocolo)\n    {\n    }\n\n    /**\n     * @return Collection<int, CategoriaServico>\n     */\n    public function listarCategorias(?string $termoDeBusca, bool $somenteEmDestaque): Collection\n    {\n        return CategoriaServico::query()\n            ->when($somenteEmDestaque, fn ($consulta) => $consulta->somenteEmDestaque())\n            ->get()\n            ->when(\n                $termoDeBusca !== null,\n                fn (Collection $categorias) => $categorias->filter(\n                    fn (CategoriaServico $categoria) => $this->contemTermo(\"{$categoria->nome} {$categoria->descricao}\", $termoDeBusca),\n                ),\n            )\n            ->sortBy(fn (CategoriaServico $categoria) => $this->normalizar($categoria->nome))\n            ->values();\n    }\n\n    public function buscarCategoriaPorSlug(string $slug): CategoriaServico\n    {\n        return CategoriaServico::where('slug', $slug)->firstOrFail();\n    }\n\n    /**\n     * @return Collection<int, Servico156>\n     */\n    public function listarServicosDaCategoria(CategoriaServico $categoria): Collection\n    {\n        return $categoria->servicos\n            ->sortBy(fn (Servico156 $servico) => $this->normalizar($servico->nome))\n            ->values();\n    }\n\n    public function buscarServicoPorSlug(string $slug): Servico156\n    {\n        return Servico156::with('categoria')->where('slug', $slug)->firstOrFail();\n    }\n\n    /**\n     * @param  list<UploadedFile>  $anexos\n     */\n    public function registrarSolicitacao(User $usuario, Servico156 $servico, array $dados, array $anexos): Solicitacao156\n    {\n        return DB::transaction(function () use ($usuario, $servico, $dados, $anexos) {\n            $solicitacao = Solicitacao156::create([\n                ...Arr::only($dados, ['descricao', 'telefone_contato', 'cep', 'logradouro', 'numero', 'bairro', 'ponto_referencia']),\n                'user_id' => $usuario->id,\n                'servico156_id' => $servico->id,\n                'categoria_servico_id' => $servico->categoria_servico_id,\n                'protocolo' => $this->geradorDeProtocolo->gerar(self::PREFIXO_DO_PROTOCOLO, Solicitacao156::class),\n            ]);\n\n            foreach ($anexos as $anexo) {\n                $solicitacao->anexos()->create([\n                    'nome_original' => $anexo->getClientOriginalName(),\n                    'caminho' => $anexo->store(\"solicitacoes-156/{$solicitacao->protocolo}\", self::DISCO_DOS_ANEXOS),\n                ]);\n            }\n\n            return $solicitacao;\n        });\n    }\n\n    public function buscarSolicitacaoDoUsuario(User $usuario, string $protocolo): Solicitacao156\n    {\n        return $usuario->solicitacoes156()\n            ->with(['servico', 'categoria', 'anexos'])\n            ->where('protocolo', $protocolo)\n            ->firstOrFail();\n    }\n\n    private function contemTermo(string $texto, string $termo): bool\n    {\n        return str_contains($this->normalizar($texto), $this->normalizar($termo));\n    }\n\n    /**\n     * Busca e ordenação ignoram acento e caixa no PHP porque o SQLite compara\n     * bytes e o MySQL aplica a collation: no banco, o resultado mudaria\n     * conforme o ambiente.\n     */\n    private function normalizar(string $texto): string\n    {\n        return mb_strtolower(Str::ascii($texto));\n    }\n}\n"}]}]},"color":{"bgColor":"hsla(45, 100%, 82%, 1)","bgName":"yellow-l"},"nodeType":"block"},{"uid":"kGgoqCfEwM","position":{"x":1630,"y":1670},"sizes":{"width":1270,"height":109},"autoheight":true,"blockContent":{"type":"doc","content":[{"type":"filePathNode","attrs":{"pathToFile":"","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"novo156\\app\\Models\\CategoriaServico.php"}]},{"type":"paragraph","content":[{"type":"text","text":" "}]}]},"color":{"bgColor":"hsla(261, 26%, 26%, 1)","bgName":"purple"},"nodeType":"block"},{"uid":"R8mA0dM6-u","position":{"x":1630,"y":1790},"sizes":{"width":1270,"height":109},"autoheight":true,"blockContent":{"type":"doc","content":[{"type":"filePathNode","attrs":{"pathToFile":"","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"novo156\\app\\Models\\Servico156.php"}]},{"type":"paragraph","content":[{"type":"text","text":" "}]}]},"color":{"bgColor":"hsla(261, 26%, 26%, 1)","bgName":"purple"},"nodeType":"block"},{"uid":"dNsOMvOdW2","position":{"x":1630,"y":1910},"sizes":{"width":1270,"height":109},"autoheight":true,"blockContent":{"type":"doc","content":[{"type":"filePathNode","attrs":{"pathToFile":"","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"novo156\\app\\Models\\Solicitacao156.php"}]},{"type":"paragraph","content":[{"type":"text","text":" "}]}]},"color":{"bgColor":"hsla(261, 26%, 26%, 1)","bgName":"purple"},"nodeType":"block"},{"uid":"QWWD_FMIcD","position":{"x":1850,"y":-710},"sizes":{"width":80,"height":91.5},"autoheight":true,"blockContent":{"type":"doc","content":[{"type":"heading","attrs":{"level":2},"content":[{"type":"text","text":"  "},{"type":"text","marks":[{"type":"bold"}],"text":"4"}]}]},"color":{"bgColor":"hsla(205, 100%, 87%, 1)","bgName":"blue-l"},"nodeType":"block"},{"uid":"2J0gJvee38","position":{"x":2336.494023602637,"y":-417.08707314369803},"sizes":{"width":400,"height":767},"autoheight":true,"blockContent":{"content":[{"type":"filePathNode","attrs":{"pathToFile":"","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"novo156\\app\\Services\\GeradorDeProtocolo.php"}]},{"type":"codeBlock","attrs":{"language":"php","wrapCode":true},"content":[{"type":"text","text":"<?php\n\nnamespace App\\Services;\n\nuse Illuminate\\Database\\Eloquent\\Model;\n\nclass GeradorDeProtocolo\n{\n    /**\n     * Lógica provisória, à espera da definição oficial de protocolo: o\n     * sequencial é a contagem do ano + 1, então repete número se algum\n     * registro for excluído.\n     *\n     * @param  class-string<Model>  $modeloDaSolicitacao\n     */\n    public function gerar(string $prefixo, string $modeloDaSolicitacao): string\n    {\n        $ano = now()->year;\n\n        $quantidadeNoAno = $modeloDaSolicitacao::query()\n            ->whereYear('created_at', $ano)\n            ->lockForUpdate()\n            ->count();\n\n        $sequencial = str_pad((string) ($quantidadeNoAno + 1), 6, '0', STR_PAD_LEFT);\n\n        return \"{$prefixo}-{$ano}-{$sequencial}\";\n    }\n}\n"}]}]},"nodeType":"block"},{"uid":"X18SIaHmY2","position":{"x":2336.494023602637,"y":-417.08707314369803},"sizes":{"width":400,"height":767},"autoheight":true,"blockContent":{"content":[{"type":"filePathNode","attrs":{"pathToFile":"","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"novo156\\app\\Services\\GeradorDeProtocolo.php"}]},{"type":"codeBlock","attrs":{"language":"php","wrapCode":true},"content":[{"type":"text","text":"<?php\n\nnamespace App\\Services;\n\nuse Illuminate\\Database\\Eloquent\\Model;\n\nclass GeradorDeProtocolo\n{\n    /**\n     * Lógica provisória, à espera da definição oficial de protocolo: o\n     * sequencial é a contagem do ano + 1, então repete número se algum\n     * registro for excluído.\n     *\n     * @param  class-string<Model>  $modeloDaSolicitacao\n     */\n    public function gerar(string $prefixo, string $modeloDaSolicitacao): string\n    {\n        $ano = now()->year;\n\n        $quantidadeNoAno = $modeloDaSolicitacao::query()\n            ->whereYear('created_at', $ano)\n            ->lockForUpdate()\n            ->count();\n\n        $sequencial = str_pad((string) ($quantidadeNoAno + 1), 6, '0', STR_PAD_LEFT);\n\n        return \"{$prefixo}-{$ano}-{$sequencial}\";\n    }\n}\n"}]}]},"nodeType":"block"},{"uid":"n2OG6gYogr","position":{"x":540,"y":860},"sizes":{"width":710,"height":662},"autoheight":true,"blockContent":{"type":"doc","content":[{"type":"filePathNode","attrs":{"pathToFile":"","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"novo156\\app\\Services\\GeradorDeProtocolo.php"}]},{"type":"codeBlock","attrs":{"language":"php","wrapCode":true},"content":[{"type":"text","text":"<?php\n\nnamespace App\\Services;\n\nuse Illuminate\\Database\\Eloquent\\Model;\n\nclass GeradorDeProtocolo\n{\n    /**\n     * Lógica provisória, à espera da definição oficial de protocolo: o\n     * sequencial é a contagem do ano + 1, então repete número se algum\n     * registro for excluído.\n     *\n     * @param  class-string<Model>  $modeloDaSolicitacao\n     */\n    public function gerar(string $prefixo, string $modeloDaSolicitacao): string\n    {\n        $ano = now()->year;\n\n        $quantidadeNoAno = $modeloDaSolicitacao::query()\n            ->whereYear('created_at', $ano)\n            ->lockForUpdate()\n            ->count();\n\n        $sequencial = str_pad((string) ($quantidadeNoAno + 1), 6, '0', STR_PAD_LEFT);\n\n        return \"{$prefixo}-{$ano}-{$sequencial}\";\n    }\n}\n"}]}]},"color":{"bgColor":"hsla(45, 100%, 82%, 1)","bgName":"yellow-l"},"nodeType":"block"}],"configs":{"centerX":657.0265028156701,"centerY":2118.1290360434277,"zoomLevel":0.4333333333333333},"arrowData":{"arrowsMap":{"arrow-point-bI0wBh3Ufk-bottom-point-PSPLIYKa9J-top":{"to":"point-PSPLIYKa9J-top","from":"point-bI0wBh3Ufk-bottom","label":"Normal Box","direction":"ft","selectable":true},"arrow-point-bI0wBh3Ufk-bottom-point-ytXK_ayIc1-top":{"to":"point-ytXK_ayIc1-top","from":"point-bI0wBh3Ufk-bottom","label":"Code Box","direction":"ft","selectable":true},"arrow-point-hyyRZE3E8u-right-point-6ZopTaEaDZ-left":{"to":"point-6ZopTaEaDZ-left","from":"point-hyyRZE3E8u-right","label":"call","direction":"ft","selectable":true}},"pointsMap":{"point-PSPLIYKa9J-top":{"x":805.9999797489683,"y":60,"id":"point-PSPLIYKa9J-top","direction":"top"},"point-ytXK_ayIc1-top":{"x":205.99999493724206,"y":60,"id":"point-ytXK_ayIc1-top","direction":"top"},"point-6ZopTaEaDZ-left":{"x":220,"y":605.9999898744841,"id":"point-6ZopTaEaDZ-left","direction":"left"},"point-hyyRZE3E8u-right":{"x":100,"y":606,"id":"point-hyyRZE3E8u-right","direction":"right"},"point-bI0wBh3Ufk-bottom":{"x":515.99997974