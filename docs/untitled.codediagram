   $filtroSelecionado = $request->filtroSelecionado();\n\n    $categorias = CategoriaServico::query()\n        ->when(\n            $filtroSelecionado === BuscarCategoriasServicoRequest::FILTRO_PRINCIPAIS,\n            fn ($consulta) => $consulta->somenteEmDestaque(),\n        )\n        ->when(\n            $termoDeBusca !== null,\n            fn ($consulta) => $consulta->contendoTermo($termoDeBusca),\n        )\n        ->get()\n        ->sortBy(fn (CategoriaServico $categoria) => $this->chaveDeOrdenacaoAlfabetica($categoria->nome))\n        ->values();\n\n    return view('servicos.156.categoria-servicos', [\n        'categorias' => $categorias,\n        'termoDeBusca' => $termoDeBusca,\n        'filtroSelecionado' => $filtroSelecionado,\n    ]);\n}"}]}]},"color":{"bgColor":"hsla(205, 100%, 87%, 1)","bgName":"blue-l"},"nodeType":"block"},{"uid":"xW6mVpn6PI","position":{"x":260,"y":-1340},"sizes":{"width":429.953125,"height":80},"autoheight":false,"blockContent":{"type":"doc","content":[{"type":"filePathNode","attrs":{"pathToFile":"","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"novo156\\app\\Http\\Requests\\EntrarRequest.php"}]},{"type":"paragraph","content":[{"type":"text","text":" "}]}]},"color":{"bgColor":"hsla(268, 100%, 90%, 1)","bgName":"purple-l"},"nodeType":"block"},{"uid":"BW2Ws5uE-h","position":{"x":-400,"y":-1610},"sizes":{"width":499.953125,"height":70},"autoheight":false,"blockContent":{"type":"doc","content":[{"type":"filePathNode","attrs":{"pathToFile":"","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"novo156\\app\\Rules\\ValidaCpf.php"}]},{"type":"paragraph","content":[{"type":"text","text":" "}]}]},"color":{"bgColor":"hsla(140, 76%, 82%, 1)","bgName":"green-l"},"nodeType":"block"},{"uid":"-cclks-smH","position":{"x":280,"y":-1630},"sizes":{"width":520,"height":80},"autoheight":false,"blockContent":{"type":"doc","content":[{"type":"filePathNode","attrs":{"pathToFile":"","version":1},"content":[{"