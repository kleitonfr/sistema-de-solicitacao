       ->withErrors(['email' => 'E-mail ou senha inválidos.']);\n    }\n\n    $request->session()->regenerate();\n\n    return redirect()->route('servicos.index');\n}"}]}]},"color":{"bgColor":"hsla(205, 100%, 87%, 1)","bgName":"blue-l"},"nodeType":"block"},{"uid":"ODL3umm4IE","position":{"x":-150,"y":-3040},"sizes":{"width":80,"height":90},"autoheight":false,"blockContent":{"type":"doc","content":[{"type":"heading","attrs":{"level":2},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"  1"}]}]},"color":{"bgColor":"hsla(205, 100%, 87%, 1)","bgName":"blue-l"},"nodeType":"block"},{"uid":"5T8e8owd9c","position":{"x":290,"y":-1540},"sizes":{"width":449.953125,"height":109.953125},"autoheight":false,"blockContent":{"type":"doc","content":[{"type":"filePathNode","attrs":{"pathToFile":"","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"novo156\\app\\Http\\Controllers\\AutocadastroController.php"}]},{"type":"heading","attrs":{"level":2},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"2"}]},{"type":"codeBlock","attrs":{"language":"php","wrapCode":true},"content":[{"type":"text","text":"public function storeFisica(Request $request): RedirectResponse\n{\n    $validated = $request->validate([\n        'nome_completo' => ['required', 'string', 'max:255'],\n        'cpf' => ['required', 'string', 'max:14'],\n        'nome_social' => ['nullable', 'string', 'max:255'],\n        'nome_mae' => ['nullable', 'string', 'max:255'],\n        'data_nascimento' => ['required', 'date'],\n        'sexo' => ['required', 'string', 'in:feminino,masculino,outro,nao_informar'],\n        'faixa_etaria' => ['required', 'string', 'in:ate_17,18_24,25_34,35_44,45_59,60_mais'],\n        'escolaridade' => ['required', 'string', 'in:fundamental,medio,superior,pos_graduacao,nao_informar'],\n        'profissao' => ['nullable', 'string', 'max:255'],\n        'email' => ['required', 'email', 'max:255'],\n        'email_confirmacao' => ['required', 'email', 'same:email'],\n\n        'telefone_tipo' => ['required', 'string', 'in:celular,residencial,comercial,recado'],\n        'telefone_ddd' => ['required', 'string', 'max:3'],\n        'telefone_numero' => ['required', 'string', 'max:20'],\n        'telefone_observacao' => ['nullable', 'string', 'max:255'],\n\n        'endereco_cep' => ['required', 'string', 'max:9'],\n        'endereco_logradouro' => ['required', 'string', 'max:255'],\n        'endereco_bairro' => ['required', 'string', 'max:255'],\n        'endereco_cidade' => ['required', 'string', 'max:255'],\n        'endereco_uf' => ['required', 'string', 'size:2'],\n        'endereco_numero' => ['required', 'string', 'max:20'],\n        'endereco_complemento' => ['nullable', 'string', 'max:255'],\n\n        'senha' => ['required', 'string', 'min:8'],\n        'senha_confirmacao' => ['required', 'string', 'same:senha'],\n\n        'termo_uso' => ['accepted'],\n    ]);\n\n    return $this->redirecionarComSucesso();\n}"}]}]},"color":{"bgColor":"hsla(205, 100%, 87%, 1)","bgName":"blue-l"},"nodeType":"block"},{"uid":"-0ZCj3FuDR","position":{"x":260,"y":-1860},"sizes":{"width":469.953125,"height":109.953125},"autoheight":false,"blockContent":{"type":"doc","content":[{"type":"filePathNode","attrs":{"pathToFile":"","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"novo156\\app\\Http\\Controllers\\AutocadastroController.php"}]},{"type":"heading","attrs":{"level":2},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"2"}]},{"type":"codeBlock","attrs":{"language":"php","wrapCode":true},"content":[{"type":"text","text":"public function storeJuridica(Request $request): RedirectResponse\n{\n    $validated = $request->validate([\n        'razao_social' => ['required', 'string', 'max:255'],\n        'cnpj' => ['required', 'string', 'max:18'],\n        'email' => ['required', 'email', 'max:255'],\n        'email_confirmacao' => ['required', 'email', 'same:email'],\n\n        'telefone_tipo' => ['required', 'string', 'in:celular,residencial,comercial,recado'],\n        'telefone_ddd' => ['required', 'string', 'max:3'],\n        'telefone_numero' => ['required', 'string', 'max:20'],\n        'telefone_observacao' => ['nullable', 'string', 'max:255'],\n\n        'endereco_cep' => ['required', 'string', 'max:9'],\n        'endereco_logradouro' => ['required', 'string', 'max:255'],\n        'endereco_bairro' => ['required', 'string', 'max:255'],\n        'endereco_cidade' => ['required', 'string', 'max:255'],\n        'endereco_uf' => ['required', 'string', 'size:2'],\n        'endereco_numero' => ['required', 'string', 'max:20'],\n        'endereco_complemento' => ['nullable', 'string', 'max:255'],\n\n        'senha' => ['required', 'string', 'min:8'],\n        'senha_confirmacao' => ['required', 'string', 'same:senha'],\n\n        'termo_uso' => ['accepted'],\n    ]);\n\n    return $this->redirecionarComSucesso();\n}"}]}]},"color":{"bgColor":"hsla(205, 100%, 87%, 1)","bgName":"blue-l"},"nodeType":"block"},{"uid":"2agzjvT4Ge","position":{"x":400,"y":-3790},"sizes":{"width":809.953125,"height":389.953125},"autoheight":false,"blockContent":{"type":"doc","content":[{"type":"heading","attrs":{"level":2},"content":[{"type":"text","text":"⚠ PENDÊNCIAS: "},{"type":"hardBreak"},{"type":"hardBreak"},{"type":"text","text":"1 - "},{"type":"hardBreak"},{"type":"hardBreak"},{"type":"text","text":"2 - Tabela Auditoria registro deve conter no Service;"},{"type":"hardBreak"},{"type":"hardBreak"},{"type":"text","text":"3 - Hoje, há uma tabela de anexos somente para os anexos armazenados via 156 (já que podem ser mais de um e de diferentes tipos como foto ou vídeo) Talvez futuramente centralizar essa tabela para receber os anexos de todas as entradas, - verificar ainda se não é interessante permitir pdf na solicitação 156"},{"type":"hardBreak"},{"type":"hardBreak"},{"type":"text","text":"4 - "},{"type":"hardBreak"},{"type":"hardBreak"},{"type":"text","text":"5 - "},{"type":"hardBreak"}]}]},